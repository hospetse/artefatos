System(hospetse, "HOSPETSE", "Plataforma de prestação de serviços para estadia, cuidados e passeio de pets")

System_Ext(payment, "Sistema de Pagamento", "Processa pagamentos, estornos e repasses")
System_Ext(maps, "Sistema de Mapas", "Localização, geocodificação e rotas")
