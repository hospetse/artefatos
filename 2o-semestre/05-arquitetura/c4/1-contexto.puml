@startuml hospetse_c4_context
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
skinparam linetype ortho

Title HOSPETSE — C4 Context — Arquitetura alvo

Person(tutor, "Tutor", "Busca e contrata serviços para pets")
Person(host, "Host", "Oferece hospedagem para pets")
Person(sitter, "Pet Sitter", "Oferece cuidados e visitas")
