@startuml 03_Web_Cadastros_e_Auditoria
 title HOSPETSE — Web — Cadastros de prestadores e auditoria
 left to right direction
 skinparam packageStyle rectangle
 skinparam shadowing false
 skinparam defaultFontName Arial
 skinparam linetype polyline
 skinparam nodesep 50
 skinparam ranksep 40
 skinparam usecase {
   BackgroundColor #FFFFFF
   BorderColor #444444
 }
 skinparam ArrowColor #333333

 actor "Administrador" as admin

 rectangle "HOSPETSE" {
   package "Web — Cadastros de prestadores" {
     usecase "HPET20b\nValidar Cadastro de\nHost/Prestador" as UC20b
   }
   package "Web — Auditoria" {
     usecase "HPET47\nConsultar Trilha\nde Auditoria" as UC47
   }
 }

 admin -- UC20b
 admin -- UC47

 legend right
   <b>Escopo</b>
   As duas caixas pequenas foram agrupadas\n   para evitar um diagrama vazio.
 endlegend
@enduml
